        "type": "object",
        "required": ["goal", "allowed_skills", "acceptance_criteria"],
        "properties": {
          "goal": {"type": "string"},
          "allowed_skills": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
