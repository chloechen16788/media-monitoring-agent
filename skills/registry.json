      "output_schema": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {"type": "boolean"},
          "data": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    {
      "id": "bmw_tag_jsonl",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/bmw_tag_jsonl.py",
      "enabled": true,
      "env": ["SKILL_TAGGING_API_KEY", "SKILL_TAGGING_BASE_URL", "SKILL_TAGGING_MODEL", "SKILL_TAGGING_PROXY"],
      "brief": "读取 JSONL 调用标注模型(默认Gemini原生API,可扩展gateway/local)做 BMW 硬核科技新闻标注，写回 annotated JSONL。",
