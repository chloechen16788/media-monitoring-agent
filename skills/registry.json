          "peak_series": {"type": "string"},
          "granularity": {"type": "string", "enum": ["hour", "day", "month"], "default": "day"},
          "title": {"type": "string"},
          "theme": {"type": "string", "enum": ["default", "dark"], "default": "default"},
          "top_peaks": {"type": "integer", "minimum": 1, "default": 3}
