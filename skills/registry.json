          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "extracted_count": {"type": "integer"},
          "articles": {"type": "array", "items": {"type": "object"}},
          "error": {"type": "string"},
          "hint": {"type": "string"},
          "details": {"type": "string"}
        }
      }
