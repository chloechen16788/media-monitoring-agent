      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/es_export_jsonl_batches.py",
      "enabled": true,
      "brief": "将 ES 抽样结果按批切分为 JSONL 并生成 manifest，支撑分批标注流转。",
      "input_schema": {
