{
  "version": "v2",
  "description": "Unified skill registry for master/sub agent architecture. Single source of truth; catalog.json briefs must stay identical.",
  "skills": [
    {
      "id": "identify_report_type",
      "type": "script",
      "role": "master",
      "group": "planner",
      "entry": "skills/planner/identify_report_type.py",
      "enabled": true,
      "brief": "【Master 规划】根据用户意图识别报告类型（品牌月报 / 竞品周报）。",
      "input_schema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "description": "用户意图文本"}
        }
      }
    },
    {
      "id": "plan_charts",
      "type": "script",
      "role": "master",
      "group": "planner",
      "entry": "skills/planner/plan_charts.py",
      "enabled": true,
      "brief": "【Master 规划】基于报告类型输出图表计划与建议的 allowed_skills。",
      "input_schema": {
        "type": "object",
        "required": ["report_type"],
        "properties": {
          "report_type": {"type": "string", "description": "报告类型，如 brand_monthly / competitor_weekly"}
        }
      }
    },
    {
      "id": "write_task_contract",
      "type": "script",
      "role": "master",
      "group": "planner",
      "entry": "skills/planner/write_task_contract.py",
      "enabled": true,
      "brief": "【Master 规划】把规划结果（goal/allowed_skills/acceptance_criteria）校验后写入项目任务契约，供用户确认后交接 Sub 执行。每轮规划完成必须调用。",
      "env": ["WORKER_TASK_CONTRACT_FILE"],
      "input_schema": {
        "type": "object",
        "required": ["goal", "allowed_skills", "acceptance_criteria"],
        "properties": {
          "goal": {"type": "string"},
          "allowed_skills": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "input_context": {"type": "object"},
          "output_schema": {"type": "object"},
          "task_id": {"type": "string"}
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {"type": "boolean"},
          "data": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    {
      "id": "es_agg_search",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/es_agg_search.py",
      "enabled": true,
      "brief": "执行宏观数据统计与聚合。支持声量份额/趋势/渠道/情感及实体、词频、分类标签占比与趋势等多维交叉统计。",
      "env": ["SKILL_ES_URL", "SKILL_ES_TIMEOUT_SEC", "SKILL_ES_MAX_RETRIES"],
      "input_schema": {
        "type": "object",
        "required": ["task_ids", "start_time", "end_time", "dimensions"],
        "properties": {
          "uid": {"type": ["string", "integer"]},
          "partition": {"type": "string"},
          "task_ids": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "start_time": {"type": "string"},
          "end_time": {"type": "string"},
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sov",
                "trend",
                "channel",
                "sentiment",
                "sources",
                "effect_metrics",
                "trend_by_channel",
                "trend_by_sentiment",
                "prn_distribution",
                "named_entities",
                "keyword_freq",
                "category",
                "sub_category",
                "tag",
                "trend_by_category",
                "trend_by_tag"
              ]
            },
            "minItems": 1
          },
          "sentiment_filter": {"type": "array", "items": {"type": "integer"}},
          "entity_top_n": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
          "es_timeout_sec": {"type": "integer", "minimum": 5, "maximum": 300, "default": 60},
          "es_max_retries": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2}
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "total_hits": {"type": "integer"},
          "aggs": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"},
          "details": {"type": "string"},
          "es": {"type": "object"}
        }
      }
    },
    {
      "id": "es_sample_search",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/es_sample_search.py",
      "enabled": true,
      "brief": "微观聚类抽样。基于相似度指纹(finger)获取特定任务下传播声量最大的、不重复的首发新闻与评论长文本，用于大模型归因分析。",
      "env": ["SKILL_ES_URL", "SKILL_ES_TIMEOUT_SEC", "SKILL_ES_MAX_RETRIES"],
      "input_schema": {
        "type": "object",
        "required": ["task_ids", "start_time", "end_time"],
        "properties": {
          "uid": {"type": ["string", "integer"]},
          "partition": {"type": "string"},
          "task_ids": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "start_time": {"type": "string"},
          "end_time": {"type": "string"},
          "keywords": {"type": "string"},
          "size": {"type": "integer", "minimum": 1},
          "content_max_chars": {"type": "integer", "minimum": 0, "default": 1500},
          "output_jsonl": {"type": "string"},
          "include_articles": {"type": "boolean"},
          "es_timeout_sec": {"type": "integer", "minimum": 5, "maximum": 300, "default": 60},
          "es_max_retries": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2},
          "sentiment_filter": {"type": "integer"},
          "channel_filter": {
            "oneOf": [
              {"type": "integer"},
              {"type": "array", "items": {"type": "integer"}, "minItems": 1}
            ]
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "extracted_count": {"type": "integer"},
          "articles": {"type": "array", "items": {"type": "object"}},
          "error": {"type": "string"},
          "hint": {"type": "string"},
          "details": {"type": "string"},
          "es": {"type": "object"}
        }
      }
    },
    {
      "id": "export_es_sample_excel",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/export_es_sample_excel.py",
      "enabled": true,
      "brief": "将 es_sample_search 抽样结果或标注后 JSONL 导出为 Excel（xlsx），保留全部字段并返回下载路径。",
      "input_schema": {
        "type": "object",
        "properties": {
          "articles": {"type": "array", "items": {"type": "object"}},
          "sample_output": {"type": "object"},
          "es_sample_output": {"type": "object"},
          "input_jsonl_dir": {"type": "string"},
          "input_jsonl": {"type": "string"},
          "report_name": {"type": "string"},
          "filename": {"type": "string", "description": "导出文件名，未带 .xlsx 时自动补上"},
          "export_dir": {"type": "string", "default": "./workspace"}
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {"type": "boolean"},
          "data": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    {
      "id": "es_export_jsonl_batches",
