      "id": "render_line_chart",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/render_line_chart.py",
      "enabled": true,
      "brief": "将时间序列数据渲染为 ECharts 折线图配置：支持单线与多指标多线（series_field），含主题样式与峰值标注，并返回峰值供抽样归因。",
