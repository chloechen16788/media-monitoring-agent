          "content_max_chars": {"type": "integer", "minimum": 0, "default": 2000},
          "provider": {"type": "string", "enum": ["gemini", "gateway", "local"], "default": "gemini"},
          "max_workers": {"type": "integer", "minimum": 1, "maximum": 64, "default": 2},
          "max_records": {"type": "integer", "minimum": 1, "default": 1500},
          "flush_every": {"type": "integer", "minimum": 1, "default": 100},
          "progress_file": {"type": "string"},
          "manifest_path": {"type": "string"},
          "batch_id": {"type": "integer"},
          "prompt_override": {"type": "string"},
          "batch_prompt_override": {"type": "string"}
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {"type": "boolean"},
          "data": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    {
