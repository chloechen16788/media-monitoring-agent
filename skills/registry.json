      "output_schema": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {"type": "boolean"},
          "data": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    {
      "id": "es_agg_search",
      "type": "script",
      "role": "sub",
      "group": "executor",
      "entry": "skills/executor/es_agg_search.py",
      "enabled": true,
      "brief": "执行宏观数据统计与聚合。支持声量份额/趋势/渠道/情感及实体、词频、分类标签占比与趋势等多维交叉统计。",
      "env": ["SKILL_ES_URL"],
      "input_schema": {
        "type": "object",
        "required": ["task_ids", "start_time", "end_time", "dimensions"],
        "properties": {
          "uid": {"type": ["string", "integer"]},
          "partition": {"type": "string"},
          "task_ids": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "start_time": {"type": "string"},
          "end_time": {"type": "string"},
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sov",
                "trend",
                "channel",
                "sentiment",
                "sources",
                "effect_metrics",
                "trend_by_channel",
                "trend_by_sentiment",
                "prn_distribution",
                "named_entities",
                "keyword_freq",
                "category",
                "sub_category",
                "tag",
                "trend_by_category",
                "trend_by_tag"
              ]
            },
            "minItems": 1
          },
          "sentiment_filter": {"type": "array", "items": {"type": "integer"}},
          "entity_top_n": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "total_hits": {"type": "integer"},
          "aggs": {"type": "object"},
          "error": {"type": "string"},
          "hint": {"type": "string"},
          "details": {"type": "string"}
        }
      }
    },
