# BMW tagging (Gemini native)
SKILL_TAGGING_API_KEY=
SKILL_TAGGING_BASE_URL=https://generativelanguage.googleapis.com
SKILL_TAGGING_MODEL=gemini-2.0-flash
SKILL_TAGGING_TIMEOUT_SEC=120
# Optional, for proxy environments:
# SKILL_TAGGING_PROXY=http://127.0.0.1:7890

# Gateway fallback (OpenAI compatible)
# SKILL_TAGGING_GATEWAY_URL=
# SKILL_TAGGING_GATEWAY_MODEL=
# SKILL_TAGGING_GATEWAY_API_KEY=
# SKILL_TAGGING_ENV=qa
